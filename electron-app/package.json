{
  "name": "altwisp-electron",
  "version": "2.0.0",
  "description": "Fast, private voice dictation for Windows",
  "author": "ALTWISP",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:worker": "powershell -ExecutionPolicy Bypass -File scripts/build-worker.ps1",
    "dist": "npm run build:worker && electron-builder --win nsis",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.altwisp.desktop",
    "productName": "ALTWISP",
    "icon": "assets/icon.ico",
    "compression": "store",
    "files": ["electron/**/*", "renderer/**/*", "package.json"],
    "extraResources": [
      {"from": "native/dist/altwisp-worker.exe", "to": "native/altwisp-worker.exe"},
      {"from": "assets/tray.png", "to": "assets/tray.png"}
    ],
    "win": {"target": "nsis", "icon": "assets/icon.ico", "artifactName": "ALTWISP-Setup-${version}.${ext}"},
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "useZip": true,
      "shortcutName": "ALTWISP",
      "runAfterFinish": true
    }
  }
}
