{
  "name": "altwisp-electron",
  "version": "2.0.3",
  "description": "Fast, private voice dictation for Windows",
  "author": "ALTWISP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OREWA-PRANESH/ALTWISP.git",
    "directory": "electron-app"
  },
  "bugs": "https://github.com/OREWA-PRANESH/ALTWISP/issues",
  "homepage": "https://github.com/OREWA-PRANESH/ALTWISP#readme",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:worker": "powershell -ExecutionPolicy Bypass -File scripts/build-worker.ps1",
    "dist": "npm run build:worker && electron-builder --win nsis",
    "test": "node --test tests/*.test.js",
    "test:overlay": "electron tests/overlay-runtime.cjs"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.altwisp.desktop",
    "productName": "ALTWISP",
    "icon": "assets/icon.ico",
    "compression": "normal",
    "afterPack": "scripts/package-windows.js",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "licenses/ALTWISP.txt"
      },
      {
        "from": "native/dist/altwisp-worker.exe",
        "to": "native/altwisp-worker.exe"
      },
      {
        "from": "assets/tray.png",
        "to": "assets/tray.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "ALTWISP-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ALTWISP",
      "runAfterFinish": true
    }
  }
}
